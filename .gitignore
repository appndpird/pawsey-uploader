# --- Pawsey Uploader: never commit credentials or runtime state ---
.pawsey_uploader/
config.json
*.rclone.conf
rclone.conf
heartbeat.json
resume.json
transfer_log.jsonl
last_transfer.json
bisync_pairs.json
logs/

# --- old / numbered working copies of the script (keep only pawsey_uploader.py) ---
pawsey_uploader[0-9]*.py
pawsey_uploader-old.py
pawsey_uploader_backup*.py

# --- PyInstaller / build artifacts ---
build/
__pycache__/
*.pyc
*.pyo

# dist/ is ignored EXCEPT the shipped Windows executables (committed deliberately).
# The app was renamed to PDMA at v2.0; PDMA-v<x.y>.exe are the shipped releases
# (newest = latest). The older PawseyUploader*.exe builds are kept for history.
dist/*
!dist/PawseyUploader.exe
!dist/PawseyUploader-v*.exe
!dist/PDMA-v*.exe

# --- bundled rclone binary / archive (don't ship it in the repo) ---
rclone
rclone.exe
rclone-*/
rclone-*.zip
*.zip

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
*.log
